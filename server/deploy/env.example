# Copy to .env on the box (chmod 600) and fill in. Never commit the real one.
# The token of the Cloudflare tunnel whose public hostname hf.gamestao.com routes to http://collector:8787
HF_TUNNEL_TOKEN=
# Who to write to about the data, shown on https://hf.gamestao.com/privacy (an email address)
HF_PRIVACY_CONTACT=
# The most the replays may take before the oldest go (bytes; empty = 1 GiB)
HF_REPLAY_BYTES=
