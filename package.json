{
  "name": "hexfront-rush",
  "version": "0.4.1",
  "description": "Hexfront Rush: a hex-territory real-time strategy game with a deterministic lockstep engine and 1v1 online play",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:playgama": "vite --config vite.playgama.config.js",
    "build:playgama": "tsc --noEmit && vite build --config vite.playgama.config.js && python scripts/pack_playgama.py",
    "relay": "node server/relay.ts",
    "start": "npm run build && node server/relay.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "balance": "node --import ./scripts/tsResolve.mjs scripts/balance.ts",
    "ailab": "node --import ./scripts/tsResolve.mjs scripts/aiLab.ts",
    "hclab": "node --import ./scripts/tsResolve.mjs scripts/hcLab.ts",
    "ladder": "node --import ./scripts/tsResolve.mjs scripts/ladder.ts",
    "replays": "node --import ./scripts/tsResolve.mjs scripts/replays.ts",
    "collect": "node server/collect.ts",
    "pack:collector": "node scripts/packCollector.mjs",
    "check:filelength": "node scripts/checkFileLength.mjs",
    "check": "npm run typecheck && npm test && npm run check:filelength",
    "campaign": "node --import ./scripts/tsResolve.mjs scripts/campaign.ts",
    "campaigntune": "node --import ./scripts/tsResolve.mjs scripts/campaignTune.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.10"
  }
}
